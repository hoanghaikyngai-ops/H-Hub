local palette = {
    Color3.fromRGB(0, 120, 255),
    Color3.fromRGB(20, 160, 255),
    Color3.fromRGB(0, 90, 220),
    Color3.fromRGB(60, 190, 255),
    Color3.fromRGB(0, 200, 255),
}

local rng = Random.new(1337)
local blocks = {}
local MAX_LAYER = 12

local function addBlock(x, y, z, sx, sy, sz, layer)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.Size = Vector3.new(sx, sy, sz)
    p.Material = Enum.Material.Neon
    p.Color = palette[rng:NextInteger(1, #palette)]
    p.Parent = vp

    local target = Vector3.new(x, y, z)
    local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 1), rng:NextNumber(-1, 1)).Unit
    local scatter = target + dir * rng:NextNumber(14, 30)

    table.insert(blocks, {
        part = p,
        target = target,
        scatter = scatter,
        rot = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3)),
        layer = layer,
    })
end

-- Tạo toà nhà dạng bậc thang (setback tower)
local function addGrid(n, layerY, layer)
    local off = (n + 1) / 2
    for i = 1, n do
        for k = 1, n do
            addBlock(i - off, layerY, k - off, 0.92, 0.92, 0.92, layer)
        end
    end
end

local layer = 0
for y = 0, 3 do addGrid(4, y, layer); layer += 1 end   -- tầng đế 4x4
for y = 4, 7 do addGrid(3, y, layer); layer += 1 end   -- thân 3x3
for y = 8, 10 do addGrid(2, y, layer); layer += 1 end  -- đỉnh 2x2
-- Cột ăng-ten
addBlock(0, 11, 0, 0.5, 0.92, 0.5, layer); layer += 1
addBlock(0, 12, 0, 0.3, 0.92, 0.3, layer)
MAX_LAYER = layer

