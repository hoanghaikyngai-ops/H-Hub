StatusLabel.Parent = RootHolder

-- [ KHỞI TẠO ÂM THANH NHẠC NỀN ]
local Sound = Instance.new("Sound")
Sound.SoundId = MUSIC_ASSET_ID
Sound.Volume = 2
Sound.Parent = CoreGui
Sound:Play()

-- [ GIAI ĐOẠN HOẠT ĐỘNG XUYÊN SUỐT 1 PHÚT 2 GIÂY ]
local startTime = tick()
local duration = 62.0 
local connection

connection = RunService.RenderStepped:Connect(function()
    local elapsed = tick() - startTime
    
    -- 1. Xoay vòng tròn kép (Vòng ngoài quay xuôi, vòng trong quay ngược)
    if DownloadCircleBg and InnerCircle then
        DownloadCircleBg.Rotation = elapsed * 120
        InnerCircle.Rotation = -elapsed * 180
    end
    
    -- 2. Hiệu ứng lấp lánh ánh sáng chuyển màu (Xanh biển ⇄ Tím Neon) liên tục theo nhịp sóng sin
    local colorLerpFactor = (math.sin(elapsed * 4) + 1) / 2 -- Dao động từ 0 đến 1
    local currentNeonColor = Color3.fromRGB(0, 180, 255):Lerp(Color3.fromRGB(180, 0, 255), colorLerpFactor)
    
    TowerCore.BackgroundColor3 = currentNeonColor
    CoreStroke.Color = currentNeonColor
    
    -- 3. Hiệu ứng lắp ráp & tháo ra lặp đi lặp lại nhịp nhàng (Chu kỳ 4.5 giây)
    local cycleTime = elapsed % 4.5
    local isAssemblyPhase = (cycleTime < 3.0)
    
    for _, item in ipairs(towerPanels) do
        local targetPosX, targetPosY, targetTrans
        if isAssemblyPhase then
            targetPosX = item.DefaultX
            targetPosY = item.DefaultY
            targetTrans = 0.25
        else
            targetPosX = item.ScatterX
            targetPosY = item.ScatterY
            targetTrans = 0.75
        end
        
        item.Instance.Position = item.Instance.Position:Lerp(UDim2.new(0.5, targetPosX, 0.5, targetPosY), 0.1)
        item.Instance.BackgroundTransparency = item.Instance.BackgroundTransparency + (targetTrans - item.Instance.BackgroundTransparency) * 0.1
        
        -- Đổi màu lấp lánh cho từng khối panel theo hệ màu Xanh biển / Tím
        item.Instance.BackgroundColor3 = currentNeonColor
    end
    
    -- 4. Hiệu ứng rung nhẹ toàn bộ cụm tháp theo nhịp nhạc
    local shakeIntensity = 3.0
    local offsetX = math.sin(elapsed * 35) * shakeIntensity
    local offsetY = math.cos(elapsed * 40) * (shakeIntensity / 2)
    RootHolder.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
    
    -- 5. Cập nhật thông điệp trạng thái theo thời gian
    if elapsed > 3 and elapsed < 18 then
        StatusLabel.Text = "ASSEMBLING HIGH-DENSITY CYAN-PURPLE MATRIX..."
    elseif elapsed >= 18 and elapsed < 35 then
        StatusLabel.Text = "BYPASSING QUANTUM SECURITY..."
    elseif elapsed >= 35 and elapsed < 55 then
        StatusLabel.Text = "LOADING H-HUB VIP MODULES..."
    elseif elapsed >= 55 then
        StatusLabel.Text = "INITIALIZATION COMPLETE!"
    end
    
    -- 6. Kiểm tra kết thúc 62 giây hoặc hết nhạc
    if elapsed >= duration or (Sound.TimeLength > 0 and Sound.Position >= Sound.TimeLength - 0.25) then
        if connection then connection:Disconnect() end
        
        StatusLabel.Text = "LAUNCHING SCRIPT..."
        
        -- Hiệu ứng phóng to mờ dần toàn bộ cụm trước khi biến mất
        local fadeOutTween = TweenService:Create(RootHolder, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 700, 0, 700),
            BackgroundTransparency = 1
        })
        fadeOutTween:Play()
        
        for _, child in ipairs(RootHolder:GetDescendants()) do
            if child:IsA("GuiObject") then
                pcall(function()
                    TweenService:Create(child, TweenInfo.new(0.6), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
                end)
            elseif child:IsA("UIStroke") then
                TweenService:Create(child, TweenInfo.new(0.6), {Transparency = 1}):Play()
            end
        end
        
        task.wait(0.9)
        ScreenGui:Destroy()
        Sound:Destroy()
        
        -- ==========================================
        -- GỌI SCRIPT CHÍNH CỦA BẠN TẠI ĐÂY
