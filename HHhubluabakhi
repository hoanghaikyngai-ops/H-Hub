------------------------------------------------------------
-- ANIMATION
------------------------------------------------------------
local CYCLE = 7
local function clamp01(x) return math.clamp(x, 0, 1) end
local function ease(x) return x * x * (3 - 2 * x) end

local function blockAlpha(c, layerN)
    local f = layerN / MAX_LAYER
    if c < 3 then
        return ease(clamp01((c - f * 1.0) / 1.5))            -- ghép từ dưới lên
    elseif c < 4.8 then
        return 1                                              -- giữ nguyên toà nhà
    elseif c < 6.8 then
        return 1 - ease(clamp01((c - 4.8 - (1 - f) * 0.7) / 1.2)) -- vỡ từ trên xuống
    else
        return 0
    end
end

local startTime = os.clock()
local conn
local finished = false

conn = RunService.RenderStepped:Connect(function()
    local t = os.clock() - startTime
    local c = t % CYCLE

    -- Camera xoay nhẹ trái/phải quanh toà nhà
    local swing = math.sin(t * 0.9) * 0.6
    local center = Vector3.new(0, 6, 0)
    local dist = 34
    local camPos = center + Vector3.new(math.sin(swing) * dist, 4, math.cos(swing) * dist)
    cam.CFrame = CFrame.lookAt(camPos, center)

    -- Khối
    for _, b in ipairs(blocks) do
        local a = blockAlpha(c, b.layer)
        local pos = b.scatter:Lerp(b.target, a)
        local inv = 1 - a
        b.part.CFrame = CFrame.new(pos)
            * CFrame.Angles(b.rot.X * inv, b.rot.Y * inv, b.rot.Z * inv)
        b.part.Transparency = inv * 0.5
    end

    -- Loading
    local prog = clamp01(t / LOAD_TIME)
    local shown = ease(prog)
    for _, s in ipairs(sides) do
        s.arcGrad.Rotation = (t * 360) % 360 * s.dir
        s.pct.Text = string.format("%d%%", math.floor(shown * 100))
        s.fill.Size = UDim2.fromScale(1, shown)
    end

    -- Kết thúc intro
    if prog >= 1 and not finished then
        finished = true
        conn:Disconnect()

        local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(bg, info, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(sound, info, { Volume = 0 }):Play()
        for _, d in ipairs(bg:GetDescendants()) do
            if d:IsA("TextLabel") then
                TweenService:Create(d, info, { TextTransparency = 1 }):Play()
            elseif d:IsA("Frame") then
                TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
            elseif d:IsA("UIStroke") then
                TweenService:Create(d, info, { Transparency = 1 }):Play()
            end
        end
        for _, b in ipairs(blocks) do
            TweenService:Create(b.part, info, { Transparency = 1 }):Play()
        end

        task.delay(0.9, function()
            sound:Stop()
            gui:Destroy()
            task.spawn(RunMainScript)
        end)
    end
end)
