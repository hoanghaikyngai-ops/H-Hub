-- Text hiển thị trạng thái
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(0, 450, 0, 30)
StatusLabel.AnchorPoint = Vector2.new(0.5, 0)
StatusLabel.Position = UDim2.new(0.5, 0, 0.82, 0)
