-- QUỸ ĐẠO HỐ ĐEN
------------------------------------------------------------
local ORBIT_START, ORBIT_END = 18, 52
local ORBIT_DUR = ORBIT_END - ORBIT_START

local function orbitPos(b, p)
    local pr = math.min(p, 1)
    local r = b.r0 + (b.rmin - b.r0) * (pr ^ 1.4)
    local th = b.th0 + b.spin * (p ^ 1.6)         -- càng gần tâm càng quay nhanh
    local y = b.yoff * (1 - pr)
    local v = Vector3.new(math.cos(th) * r, y, math.sin(th) * r)
    return CENTER + TILT:VectorToWorldSpace(v)
end

local P_END = ORBIT_DUR / ORBIT_DUR -- 1.0 ; p lúc kết thúc quỹ đạo
local P_FINAL = 1.0625              -- vẫn quay thêm chút ở giai đoạn rung

------------------------------------------------------------
-- VÒNG LẶP CHÍNH
------------------------------------------------------------
local startTime = os.clock()
local conn
local finished = false

conn = RunService.RenderStepped:Connect(function()
    local t = os.clock() - startTime

    ----------------------------------------------------
    -- Camera
    ----------------------------------------------------
    local diskF
    if t < 14 then diskF = 0
    elseif t < 18 then diskF = ease((t - 14) / 4)
    elseif t < 54 then diskF = 1
    elseif t < 57 then diskF = 1 - ease((t - 54) / 3)
    else diskF = 0 end

    local swing = math.sin(t * 0.9) * 0.6 * (1 - 0.6 * diskF)
    local dist = 34 + 8 * diskF
    local camPos = CENTER + Vector3.new(math.sin(swing) * dist, 4 + 8 * diskF, math.cos(swing) * dist)

    local shake = 0
    if t >= 48 and t < 52 then shake = (t - 48) / 4 * 0.45
    elseif t >= 52 and t < 53 then shake = 0.9 * (53 - t) end
    if shake > 0 then
        camPos += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * shake * 2
    end
    cam.CFrame = CFrame.lookAt(camPos, CENTER)

    ----------------------------------------------------
    -- Màu đỏ khi gần tâm / sáng rực khi toà nhà cuối
    ----------------------------------------------------
    local redAmt
    if t < ORBIT_START then redAmt = 0
    elseif t < ORBIT_END then
        local q = clamp01(((t - ORBIT_START) / ORBIT_DUR - 0.3) / 0.7)
        redAmt = (q ^ 1.5) * 0.8
    elseif t < 56 then redAmt = 0.8 * (1 - (t - ORBIT_END) / 4)
    else redAmt = 0 end

    local bright = 0
    if t < 14 then bright = 0.15 * ease(clamp01((t - 8) / 6)) * 0 + 0.0 end
    if t >= 57 then bright = ease(clamp01((t - 57) / 3)) * 0.65 end
    if t >= 8 and t < 14 then bright = 0.25 * math.sin(clamp01((t - 8) / 6) * math.pi) end

    ----------------------------------------------------
    -- Cập nhật từng khối
    ----------------------------------------------------
    local extra = 0.5 * clamp01((math.min(t, ORBIT_END) - ORBIT_START) / ORBIT_DUR) * ORBIT_DUR
    local jitter = (t >= 46 and t < 52) and (0.05 + (t - 46) / 6 * 0.25) or 0

    for _, b in ipairs(blocks) do
        local f = b.layer / MAX_LAYER
        local pos, chaos

        if t < 8 then
            -- ghép lại lần đầu (từ dưới lên)
            local a = ease(clamp01((t - f * 2.5) / 4.5))
            pos = b.scatter:Lerp(b.target, a)
            chaos = 1 - a
        elseif t < 14 then
            pos, chaos = b.target, 0
        elseif t < 18 then
            -- vỡ ra (từ trên xuống) tới điểm bắt đầu quỹ đạo
            local x = ease(clamp01((t - 14 - (1 - f) * 0.8) / 2.4))
            pos = b.target:Lerp(orbitPos(b, 0), x)
            chaos = x
        elseif t < ORBIT_END then
            -- xoay dần về tâm
            local p = (t - ORBIT_START) / ORBIT_DUR
            pos = orbitPos(b, p)
            chaos = 1
        elseif t < 54 then
            -- nổ tung
            local x = clamp01((t - ORBIT_END) / 1.2)
            local out = 1 - (1 - x) ^ 3
            pos = orbitPos(b, P_FINAL):Lerp(b.scatter2, out)
            chaos = 1
        else
            -- ghép lại thành toà nhà
            local a = ease(clamp01((t - 54 - f * 1.0) / 3.5))
            pos = b.scatter2:Lerp(b.target, a)
            chaos = 1 - a
        end

        if jitter > 0 and t >= 46 and t < 52 then
            pos += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * jitter
        end

        local ang = b.rot * (1 + extra) * chaos
        b.part.CFrame = CFrame.new(pos) * CFrame.Angles(ang.X, ang.Y, ang.Z)
        b.part.Transparency = chaos * 0.4
        b.part.Color = b.base:Lerp(RED, redAmt * chaos):Lerp(LIGHT, bright)
    end

    ----------------------------------------------------
    -- Lõi hố đen
    ----------------------------------------------------
    local coreR = 0
    if t >= 20 and t < ORBIT_END then
        coreR = ease(clamp01((t - 20) / 30)) * 2.6
    elseif t >= ORBIT_END and t < 52.4 then
        coreR = 2.6 * (1 - (t - ORBIT_END) / 0.4)
    end
    coreR = math.max(coreR, 0.01)
    local pulse = 0.5 + 0.5 * math.sin(t * 6)
    core.Size = Vector3.new(coreR, coreR, coreR) * 2
    shell.Size = core.Size * (1.18 + pulse * 0.08)
    shell.Transparency = 0.8 - 0.35 * clamp01((t - 20) / 32) - 0.1 * pulse

    ----------------------------------------------------
    -- Vầng sáng nền
    ----------------------------------------------------
    local glowColor, glowI
    if t < 18 then
        glowColor = BLUE
        glowI = 0.2 + 0.25 * math.sin(clamp01((t - 6) / 8) * math.pi)
    elseif t < ORBIT_END then
        glowI = 0.25 + 0.95 * ease((t - 18) / 34)
        glowColor = BLUE:Lerp(RED, ease(clamp01((t - 18) / 14)))
    elseif t < 55 then
        glowI = 1.2
        glowColor = RED:Lerp(BLUE, ease(clamp01((t - 53) / 2)))
    else
        glowI = 0.5 + 0.9 * ease(clamp01((t - 56) / 5))
        glowColor = BLUE:Lerp(LIGHT, ease(clamp01((t - 57) / 3)) * 0.6)
    end

    for i, f in ipairs(glows) do
        local size = (60 + i * 75) * (0.4 + glowI * 0.9) * (1 + pulse * 0.04)
        f.Size = UDim2.fromOffset(size, size)
        f.BackgroundColor3 = glowColor
        f.BackgroundTransparency = 1 - math.clamp(glowI * 0.2 / (i ^ 0.6), 0, 0.9)
    end

    ----------------------------------------------------
    -- Flash khi nổ
    ----------------------------------------------------
    local fl
    if t < 51.8 then fl = 1
    elseif t < 52.1 then fl = 1 - (t - 51.8) / 0.3
    elseif t < 54 then fl = (t - 52.1) / 1.9
    else fl = 1 end
    flash.BackgroundTransparency = math.clamp(fl, 0, 1)

    ----------------------------------------------------
    -- Loading UI
    ----------------------------------------------------
    local prog = clamp01(t / LOAD_TIME)
    for _, s in ipairs(sides) do
        s.arcGrad.Rotation = (t * 360) % 360 * s.dir
        s.pct.Text = string.format("%d%%", math.floor(prog * 100))
        s.fill.Size = UDim2.fromScale(1, prog)
    end

    if t < 14 then title.Text = "INITIALIZING"
    elseif t < 48 then title.Text = "LOADING..."
    elseif t < 54 then title.Text = "!!! CRITICAL !!!"
    elseif t < 60 then title.Text = "REBUILDING"
    else title.Text = "READY" end
    title.TextColor3 = (t >= 48 and t < 54) and Color3.fromRGB(255, 110, 100) or Color3.fromRGB(150, 220, 255)

    ----------------------------------------------------
    -- Kết thúc
    ----------------------------------------------------
    if prog >= 1 and not finished then
        finished = true
        conn:Disconnect()

        local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(bg, info, { BackgroundTransparency = 1 }):Play()
        TweenService:Create(sound, info, { Volume = 0 }):Play()
        for _, d in ipairs(bg:GetDescendants()) do
            if d:IsA("TextLabel") then
                TweenService:Create(d, info, { TextTransparency = 1 }):Play()
            elseif d:IsA("Frame") then
                TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
            elseif d:IsA("UIStroke") then
                TweenService:Create(d, info, { Transparency = 1 }):Play()
            end
        end
        for _, b in ipairs(blocks) do
            TweenService:Create(b.part, info, { Transparency = 1 }):Play()
        end

        task.delay(1, function()
            sound:Stop()
            gui:Destroy()
            task.spawn(RunMainScript)
        end)
    end
end)

print("[Intro] khoi tao xong")
end)

if not __ok then
    warn("[Intro] LOI: " .. tostring(__err))
    task.spawn(RunMainScript) -- intro hỏng thì vẫn chạy script chính
end
