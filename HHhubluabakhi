-- Các vạch góc nhận diện hướng xoay
for i = 0, 3 do
    local marker = Instance.new("Frame")
    marker.Size = UDim2.new(0, 6, 0, 16)
    marker.AnchorPoint = Vector2.new(0.5, 0)
    marker.Position = UDim2.new(0.5, 0, 0, 0)
    marker.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
    marker.BorderSizePixel = 0
    marker.Rotation = i * 90
    marker.Parent = DownloadCircleBg
    
    local mCorner = Instance.new("UICorner")
    mCorner.CornerRadius = UDim.new(0, 2)
