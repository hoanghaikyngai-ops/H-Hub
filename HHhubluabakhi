CoreStroke.Thickness = 1.5

-- Tạo các cánh tháp/tấm năng lượng bao quanh (Modular Panels)
local towerPanels = {}
local panelConfigs = {
    {offsetX = -65, offsetY = -50, sizeX = 30, sizeY = 80},
    {offsetX = 65, offsetY = -50, sizeX = 30, sizeY = 80},
    {offsetX = -40, offsetY = 40, sizeX = 25, sizeY = 60},
    {offsetX = 40, offsetY = 40, sizeX = 25, sizeY = 60},
    {offsetX = -90, offsetY = 10, sizeX = 20, sizeY = 50},
    {offsetX = 90, offsetY = 10, sizeX = 20, sizeY = 50},
}

for i, cfg in ipairs(panelConfigs) do
    local panel = Instance.new("Frame")
    panel.Name = "Panel_" .. i
    panel.Size = UDim2.new(0, cfg.sizeX, 0, cfg.sizeY)
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    panel.Position = UDim2.new(0.5, cfg.offsetX * 3, 0.45, cfg.offsetY * 3)
    panel.BackgroundColor3 = Color3.fromRGB(0, 255, 128) -- Xanh lá neon
    panel.BackgroundTransparency = 0.5
    panel.BorderSizePixel = 0
    panel.Parent = TowerContainer
    
    local pCorner = Instance.new("UICorner")
    pCorner.CornerRadius = UDim.new(0, 4)
    pCorner.Parent = panel
    
    local pStroke = Instance.new("UIStroke")
    pStroke.Parent = panel
    pStroke.Color = Color3.fromRGB(0, 200, 255)
    pStroke.Thickness = 1
    
    table.insert(towerPanels, {
        Instance = panel,
        DefaultX = cfg.offsetX,
        DefaultY = cfg.offsetY,
        ScatterX = cfg.offsetX * 3.5,
        ScatterY = cfg.offsetY * 3.5
    })
end

