local function addBlock(x, y, z, sx, sy, sz, layerN)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.Size = Vector3.new(sx, sy, sz)
    p.Material = Enum.Material.Neon
    local base = palette[rng:NextInteger(1, #palette)]
    p.Color = base
    p.Parent = vp

    local target = Vector3.new(x, y, z)
    local function randDir()
        return Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.6, 1), rng:NextNumber(-1, 1)).Unit
    end

    table.insert(blocks, {
        part = p,
        base = base,
        target = target,
        scatter = target + randDir() * rng:NextNumber(14, 30),     -- vị trí bay vào lúc đầu
        scatter2 = CENTER + randDir() * rng:NextNumber(25, 45),    -- vị trí văng ra khi nổ
        rot = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3)),
        layer = layerN,
        -- quỹ đạo hố đen
        r0 = rng:NextNumber(8, 26),
        rmin = rng:NextNumber(0.4, 2.2),
        th0 = rng:NextNumber(0, math.pi * 2),
        spin = rng:NextNumber(11, 20),
        yoff = rng:NextNumber(-1.8, 1.8),
    })
end

local function addGrid(n, layerY, layerN)
    local off = (n + 1) / 2
    for i = 1, n do
        for k = 1, n do
            addBlock(i - off, layerY, k - off, 0.92, 0.92, 0.92, layerN)
        end
    end
end

local layerN = 0
for y = 0, 3 do addGrid(4, y, layerN); layerN += 1 end
for y = 4, 7 do addGrid(3, y, layerN); layerN += 1 end
for y = 8, 10 do addGrid(2, y, layerN); layerN += 1 end
addBlock(0, 11, 0, 0.5, 0.92, 0.5, layerN); layerN += 1
addBlock(0, 12, 0, 0.3, 0.92, 0.3, layerN)
