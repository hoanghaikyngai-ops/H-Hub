StatusLabel.TextSize = 14
StatusLabel.Parent = MainContainer

-- [ KHỞI TẠO ÂM THANH NHẠC NỀN ]
local Sound = Instance.new("Sound")
Sound.SoundId = MUSIC_ASSET_ID
Sound.Volume = 2
Sound.Parent = CoreGui
Sound:Play()

-- [ GIAI ĐOẠN 1: CÁC KHỐI VUÔNG BAY VÀO GỘP THÀNH TÒA NHÀ ]
task.spawn(function()
    task.wait(0.5)
    StatusLabel.Text = "ASSEMBLING SCI-FI GRID..."
    
    for _, item in ipairs(gridBlocks) do
        TweenService:Create(item.Instance, TweenInfo.new(2.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
            Position = item.Target,
            BackgroundTransparency = 0.2
        }):Play()
    end
end)

-- [ GIAI ĐOẠN 2: CHẠY SUỐT 1 PHÚT 2 GIÂY (62 GIÂY) ]
local startTime = tick()
local duration = 62.0 -- Cố định thời gian chạy trọn vẹn 1 phút 2 giây
local connection

connection = RunService.RenderStepped:Connect(function()
    local elapsed = tick() - startTime
    
    -- Xoay vòng tròn download liên tục
    if DownloadCircleBg then
        DownloadCircleBg.Rotation = elapsed * 120
    end
    
    -- Hiệu ứng bảng lắc nhẹ theo nhịp nhạc
    local shakeIntensity = 3.5
    local offsetX = math.sin(elapsed * 25) * shakeIntensity
    local offsetY = math.cos(elapsed * 30) * (shakeIntensity / 2)
    MainContainer.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
    
    -- Cập nhật dòng trạng thái thay đổi theo từng giai đoạn trong 62 giây
    if elapsed > 5 and elapsed < 20 then
        StatusLabel.Text = "ESTABLISHING SECURE CONNECTION..."
    elseif elapsed >= 20 and elapsed < 40 then
        StatusLabel.Text = "BYPASSING GAME SECURITY..."
    elseif elapsed >= 40 and elapsed < 58 then
        StatusLabel.Text = "LOADING H-HUB VIP MODULES..."
    elseif elapsed >= 58 then
        StatusLabel.Text = "READY TO LAUNCH!"
    end
    
    -- Kiểm tra khi đủ 62 giây hoặc nhạc kết thúc sớm
    if elapsed >= duration or (Sound.TimeLength > 0 and Sound.Position >= Sound.TimeLength - 0.25) then
        if connection then connection:Disconnect() end
        
        -- [ GIAI ĐOẠN 3: KẾT THÚC - TẮT TOÀN BỘ VÀ CHUYỂN QUA SCRIPT CHÍNH ]
        StatusLabel.Text = "LAUNCHING MAIN SCRIPT..."
        
        -- Hiệu ứng phóng to mờ dần trước khi biến mất
        local fadeOutTween = TweenService:Create(MainContainer, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 600, 0, 400),
            BackgroundTransparency = 1
        })
        fadeOutTween:Play()
        
        -- Làm mờ các chi tiết bên trong
        for _, child in ipairs(MainContainer:GetDescendants()) do
            if child:IsA("GuiObject") then
                pcall(function()
                    TweenService:Create(child, TweenInfo.new(0.6), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
                end)
            elseif child:IsA("UIStroke") then
                TweenService:Create(child, TweenInfo.new(0.6), {Transparency = 1}):Play()
            end
        end
        
        task.wait(0.9)
        ScreenGui:Destroy()
        Sound:Destroy()
        
