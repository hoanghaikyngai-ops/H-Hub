-- [ XÂY DỰNG CẤU TRÚC TÒA NHÀ CÔNG NGHỆ CAO ĐỒ SỘ (MASSIVE SCI-FI TOWER) ]
local TowerContainer = Instance.new("Folder")
TowerContainer.Name = "SciFiTower"
TowerContainer.Parent = RootHolder

-- Phần lõi tháp chính (Core Spire)
local TowerCore = Instance.new("Frame")
TowerCore.Name = "TowerCore"
TowerCore.Size = UDim2.new(0, 50, 0, 220)
TowerCore.AnchorPoint = Vector2.new(0.5, 0.5)
TowerCore.Position = UDim2.new(0.5, 0, 0.5, 0)
TowerCore.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
TowerCore.BackgroundTransparency = 0.2
TowerCore.BorderSizePixel = 0
TowerCore.Parent = TowerContainer

local CoreCorner = Instance.new("UICorner")
CoreCorner.CornerRadius = UDim.new(0, 10)
CoreCorner.Parent = TowerCore

local CoreStroke = Instance.new("UIStroke")
CoreStroke.Parent = TowerCore
CoreStroke.Color = Color3.fromRGB(180, 0, 255) -- Viền Tím Neon
CoreStroke.Thickness = 2

-- Tăng mạnh số lượng các khối module xung quanh để tạo độ hoành tráng & dày đặc
local towerPanels = {}
local panelConfigs = {
    -- Tầng trong (Cận lõi)
    {offsetX = -75, offsetY = -70, sizeX = 35, sizeY = 90},
    {offsetX = 75, offsetY = -70, sizeX = 35, sizeY = 90},
    {offsetX = -75, offsetY = 70, sizeX = 35, sizeY = 90},
    {offsetX = 75, offsetY = 70, sizeX = 35, sizeY = 90},
    -- Tầng giữa (Mở rộng)
    {offsetX = -120, offsetY = 0, sizeX = 25, sizeY = 130},
    {offsetX = 120, offsetY = 0, sizeX = 25, sizeY = 130},
    {offsetX = 0, offsetY = -110, sizeX = 110, sizeY = 25},
    {offsetX = 0, offsetY = 110, sizeX = 110, sizeY = 25},
    -- Tầng vệ tinh (Bao quanh góc chéo)
    {offsetX = -100, offsetY = -95, sizeX = 30, sizeY = 30},
    {offsetX = 100, offsetY = -95, sizeX = 30, sizeY = 30},
    {offsetX = -100, offsetY = 95, sizeX = 30, sizeY = 30},
    {offsetX = 100, offsetY = 95, sizeX = 30, sizeY = 30},
}

for i, cfg in ipairs(panelConfigs) do
    local panel = Instance.new("Frame")
    panel.Name = "Panel_" .. i
    panel.Size = UDim2.new(0, cfg.sizeX, 0, cfg.sizeY)
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    panel.Position = UDim2.new(0.5, cfg.offsetX * 3.5, 0.5, cfg.offsetY * 3.5)
    panel.BackgroundColor3 = Color3.fromRGB(0, 255, 150) -- Xanh lá/xanh biển khởi đầu
    panel.BackgroundTransparency = 0.4
    panel.BorderSizePixel = 0
    panel.Parent = TowerContainer
    
    local pCorner = Instance.new("UICorner")
    pCorner.CornerRadius = UDim.new(0, 6)
    pCorner.Parent = panel
    
    local pStroke = Instance.new("UIStroke")
    pStroke.Parent = panel
    pStroke.Color = Color3.fromRGB(0, 200, 255)
    pStroke.Thickness = 1.5
    
    table.insert(towerPanels, {
        Instance = panel,
        DefaultX = cfg.offsetX,
        DefaultY = cfg.offsetY,
        ScatterX = cfg.offsetX * 4.2,
        ScatterY = cfg.offsetY * 4.2
    })
end

-- [ VÒNG TRÒN DOWNLOAD ĐÔI (SIÊU MỎNG, TRONG SUỐT, XOAY ĐỐI LẬP) ]
