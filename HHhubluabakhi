-- [ CẤU HÌNH NHẠC NỀN ROBlox ]
local MUSIC_ASSET_ID = "rbxassetid://1839245133" -- Thay ID nhạc của bạn vào đây

-- Dọn dẹp intro cũ nếu lỡ chạy đè
