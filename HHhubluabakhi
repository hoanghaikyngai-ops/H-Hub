local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- [ CẤU HÌNH NHẠC NỀN ROBlox ]
local MUSIC_ASSET_ID = "rbxassetid://136796809523895" -- Thay ID nhạc của bạn vào đây

-- Dọn dẹp intro cũ nếu lỡ chạy đè
if CoreGui:FindFirstChild("H_HUB_SciFiIntro") then
    CoreGui.H_HUB_SciFiIntro:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "H_HUB_SciFiIntro"
ScreenGui.Parent = CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Main Container (Bảng chứa chính)
local MainContainer = Instance.new("Frame")
MainContainer.Name = "MainContainer"
MainContainer.Parent = ScreenGui
MainContainer.AnchorPoint = Vector2.new(0.5, 0.5)
MainContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
MainContainer.Size = UDim2.new(0, 500, 0, 320)
MainContainer.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
MainContainer.BackgroundTransparency = 0.2
MainContainer.BorderSizePixel = 0

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 16)
UICorner.Parent = MainContainer

-- Viền Neon phát sáng cho bảng
local UIStroke = Instance.new("UIStroke")
UIStroke.Parent = MainContainer
UIStroke.Color = Color3.fromRGB(0, 220, 255)
UIStroke.Thickness = 2
UIStroke.Transparency = 0.3

-- [ TẠO TÒA NHÀ CÔNG NGHỆ CAO TỪ CÁC KHỐI VUÔNG XANH ]
local BuildingContainer = Instance.new("Folder")
BuildingContainer.Name = "SciFiBuilding"
BuildingContainer.Parent = MainContainer

local gridBlocks = {}
local rows, cols = 4, 8
for r = 1, rows do
    for c = 1, cols do
        local block = Instance.new("Frame")
        block.Size = UDim2.new(0, 35, 0, 35)
        block.Position = UDim2.new(0, math.random(-250, 750), 0, math.random(-250, 550))
        block.BackgroundColor3 = Color3.fromRGB(0, 255, 200)
        block.BackgroundTransparency = 0.8
        block.BorderSizePixel = 0
        block.Parent = BuildingContainer
        
        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 6)
        bCorner.Parent = block
        
        local targetX = 110 + (c * 38)
        local targetY = 60 + (r * 38)
        
        table.insert(gridBlocks, {Instance = block, Target = UDim2.new(0, targetX, 0, targetY)})
    end
end

-- [ VÒNG TRÒN DOWNLOAD / LOADING Ở GIỮA TÂM ]
local DownloadCircleBg = Instance.new("Frame")
DownloadCircleBg.Size = UDim2.new(0, 90, 0, 90)
DownloadCircleBg.AnchorPoint = Vector2.new(0.5, 0.5)
DownloadCircleBg.Position = UDim2.new(0.5, 0, 0.55, 0)
DownloadCircleBg.BackgroundColor3 = Color3.fromRGB(20, 30, 45)
DownloadCircleBg.Parent = MainContainer

local CircleCorner = Instance.new("UICorner")
CircleCorner.CornerRadius = UDim.new(1, 0)
CircleCorner.Parent = DownloadCircleBg

local CircleStroke = Instance.new("UIStroke")
