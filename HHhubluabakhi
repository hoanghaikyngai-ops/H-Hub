-- [ KHỞI TẠO ÂM THANH NHẠC NỀN ]
local Sound = Instance.new("Sound")
Sound.SoundId = MUSIC_ASSET_ID
Sound.Volume = 2
Sound.Parent = CoreGui
Sound:Play()

-- [ GIAI ĐOẠN HOẠT ĐỘNG XUYÊN SUỐT 1 PHÚT 2 GIÂY ]
local startTime = tick()
local duration = 62.0 
local connection

connection = RunService.RenderStepped:Connect(function()
    local elapsed = tick() - startTime
    
    -- 1. Vòng tròn download xoay liên tục
    if DownloadCircleBg then
        DownloadCircleBg.Rotation = elapsed * 150
    end
    
    -- 2. Hiệu ứng lắp ráp & tháo ra lặp đi lặp lại liên tục (chu kỳ 4 giây)
    local cycleTime = elapsed % 4.0
    local isAssemblyPhase = (cycleTime < 2.5)
    
    for _, item in ipairs(towerPanels) do
        local targetPosX, targetPosY, targetTrans
        if isAssemblyPhase then
            targetPosX = item.DefaultX
            targetPosY = item.DefaultY
            targetTrans = 0.3
        else
            targetPosX = item.ScatterX
            targetPosY = item.ScatterY
            targetTrans = 0.8
        end
        
        item.Instance.Position = item.Instance.Position:Lerp(UDim2.new(0.5, targetPosX, 0.45, targetPosY), 0.1)
        item.Instance.BackgroundTransparency = item.Instance.BackgroundTransparency + (targetTrans - item.Instance.BackgroundTransparency) * 0.1
    end
    
    -- 3. Hiệu ứng lắc bảng nhẹ theo nhịp
    local shakeIntensity = 3.0
    local offsetX = math.sin(elapsed * 30) * shakeIntensity
    local offsetY = math.cos(elapsed * 35) * (shakeIntensity / 2)
    MainContainer.Position = UDim2.new(0.5, offsetX, 0.5, offsetY)
    
    -- 4. Cập nhật trạng thái
    if elapsed > 3 and elapsed < 18 then
        StatusLabel.Text = "ASSEMBLING GREEN-BLUE MATRIX..."
    elseif elapsed >= 18 and elapsed < 35 then
        StatusLabel.Text = "BYPASSING SECURITY PROTOCOLS..."
    elseif elapsed >= 35 and elapsed < 55 then
        StatusLabel.Text = "LOADING H-HUB VIP MODULES..."
    elseif elapsed >= 55 then
        StatusLabel.Text = "INITIALIZATION COMPLETE!"
    end
    
    -- 5. Kiểm tra kết thúc 62 giây hoặc hết nhạc
    if elapsed >= duration or (Sound.TimeLength > 0 and Sound.Position >= Sound.TimeLength - 0.25) then
        if connection then connection:Disconnect() end
        
        StatusLabel.Text = "LAUNCHING SCRIPT..."
        
        local fadeOutTween = TweenService:Create(MainContainer, TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 600, 0, 400),
            BackgroundTransparency = 1
        })
        fadeOutTween:Play()
        
        for _, child in ipairs(MainContainer:GetDescendants()) do
            if child:IsA("GuiObject") then
                pcall(function()
                    TweenService:Create(child, TweenInfo.new(0.6), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
                end)
            elseif child:IsA("UIStroke") then
                TweenService:Create(child, TweenInfo.new(0.6), {Transparency = 1}):Play()
            end
        end
        
        task.wait(0.9)
        ScreenGui:Destroy()
        Sound:Destroy()
        
        -- ==========================================
        -- GỌI SCRIPT CHÍNH CỦA BẠN TẠI ĐÂY
